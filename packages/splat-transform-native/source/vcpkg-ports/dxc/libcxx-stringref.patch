diff --git a/include/llvm/ADT/StringRef.h b/include/llvm/ADT/StringRef.h
--- a/include/llvm/ADT/StringRef.h
+++ b/include/llvm/ADT/StringRef.h
@@ -573,6 +573,9 @@
