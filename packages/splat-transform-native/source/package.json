{
  "name": "@internal/splat-transform-native-source",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:native:win32-arm64": "cmake --workflow --preset arm64-windows-static",
    "build:native:win32-x64": "cmake --workflow --preset x64-windows-static",
    "build:native:linux-arm64-gnu": "cmake --workflow --preset arm64-linux",
    "build:native:linux-x64-gnu": "cmake --workflow --preset x64-linux",
    "build:native:darwin-arm64": "cmake --workflow --preset arm64-osx"
  }
}
