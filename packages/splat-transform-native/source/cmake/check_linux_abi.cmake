if(NOT EXISTS "${EXECUTABLE}")
    message(FATAL_ERROR "Missing executable: ${EXECUTABLE}")
endif()
find_program(READELF readelf REQUIRED)
execute_process(COMMAND "${READELF}" --version-info "${EXECUTABLE}" OUTPUT_VARIABLE versions COMMAND_ERROR_IS_FATAL ANY)
string(REGEX MATCHALL "GLIBC_[0-9]+\\.[0-9]+" symbols "${versions}")
foreach(symbol IN LISTS symbols)
    string(REPLACE "GLIBC_" "" version "${symbol}")
    if(version VERSION_GREATER "2.35")
        message(FATAL_ERROR "Ubuntu 22.04 ABI exceeded: ${symbol}")
    endif()
endforeach()
if(versions MATCHES "GLIBCXX_|CXXABI_")
    message(FATAL_ERROR "The C++ runtime must be statically linked")
endif()
execute_process(COMMAND "${READELF}" -d "${EXECUTABLE}" OUTPUT_VARIABLE dynamic COMMAND_ERROR_IS_FATAL ANY)
if(dynamic MATCHES "NEEDED[^\n]*(libvulkan|libstdc\\+\\+|libgcc_s)")
    message(FATAL_ERROR "Unexpected runtime dependency:\n${dynamic}")
endif()
message(STATUS "Ubuntu 22.04 ABI and static C++ runtime verified")
